3+4
5*6
h1$skip(7+8)
9*9
tmp <- 10+10
3-2; 4-2
h1$stop()
out <- h1$all

h1$visible()
h1$visible(TRUE)
h1$expr()
h1$expr(NULL)
h1$expr(numeric(0))
h1$expr(1:3)
h1$expr(1:3, TRUE)
h1$expr(3:1, TRUE)
h1$value(TRUE)
h1$value(1:3, addNames=TRUE)

tmp <- h1$expr(1, deparse=FALSE)
tmp[[2]] <- 3
eval(tmp)

}
